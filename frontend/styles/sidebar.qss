QWidget#SidebarWidget {
    background-color: #242424;
    border-right: 1px solid #2d2d2d;
}

QLabel#LibraryTitle {
    color: #FFFFFF;
    font-size: 22px;
    font-weight: bold;
}

QPushButton#AddFolderBtn {
    background-color: #2a2a2a;
    color: #FFFFFF;
    font-size: 12px;
    font-weight: bold;
    border-radius: 6px;
    padding: 8px 16px;
    border: none;
}

QPushButton#AddFolderBtn:hover {
    background-color: #333333;
}
