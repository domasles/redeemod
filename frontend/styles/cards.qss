Card, ActionCard, ModCard, GameCard {
    background-color: #1e1e1e;
    border-radius: 12px;
    border: 2px solid #2d2d2d;
}

Card[selected="true"] {
    border: 2px solid #007ACC;
}

QFrame#BannerFrame {
    background-color: #2a2a2a;
    border-radius: 8px;
    border: none;
}

QLabel#BannerLabel {
    color: #888888;
    font-size: 11px;
    font-weight: bold;
}

QLabel#ActionPlusLabel {
    color: #FFFFFF;
    font-size: 32px;
    font-weight: bold;
}

QLabel#CardTitleLabel {
    color: #FFFFFF;
    font-size: 13px;
    font-weight: bold;
    border: none;
    background: transparent;
}
