QMainWindow, QDialog {
    background-color: #121212;
    color: #FFFFFF;
}

QWidget#SidebarWidget {
    background-color: #242424;
    border-right: 1px solid #2d2d2d;
}

QLabel#LibraryTitle {
    color: #FFFFFF;
    font-family: "Segoe UI";
    font-size: 22px;
    font-weight: bold;
}

QPushButton#AddFolderBtn {
    background-color: #2a2a2a;
    color: #FFFFFF;
    font-family: "Segoe UI";
    font-size: 12px;
    font-weight: bold;
    border-radius: 6px;
    padding: 8px 16px;
    border: none;
}

QPushButton#AddFolderBtn:hover {
    background-color: #333333;
}

QPushButton#LaunchBtn {
    background-color: #007ACC;
    color: #FFFFFF;
    font-family: "Segoe UI";
    font-size: 12px;
    font-weight: bold;
    border-radius: 6px;
    padding: 8px 16px;
    border: none;
}

QPushButton#LaunchBtn:hover {
    background-color: #005999;
}

QScrollArea#LibraryScrollArea {
    border: none;
    background: transparent;
}

QWidget#LibraryScrollContent {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #3d3d3d;
    min-height: 20px;
    border-radius: 3px;
    margin: 2px 2px 2px 2px;
}

QScrollBar::handle:vertical:hover {
    background: #007ACC;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    height: 0px;
    background: none;
}

Card, ActionCard, ModCard, GameCard {
    background-color: #1e1e1e;
    border-radius: 12px;
    border: 2px solid #2d2d2d;
}

Card[selected="true"] {
    border: 2px solid #007ACC;
}

QFrame#BannerFrame {
    background-color: #2a2a2a;
    border-radius: 8px;
    border: none;
}

QLabel#BannerLabel {
    color: #888888;
    font-family: "Segoe UI";
    font-size: 11px;
    font-weight: bold;
}

QLabel#ActionPlusLabel {
    color: #FFFFFF;
    font-family: "Segoe UI";
    font-size: 32px;
    font-weight: bold;
}

QLabel#CardTitleLabel {
    color: #FFFFFF;
    font-family: "Segoe UI";
    font-size: 13px;
    font-weight: bold;
    border: none;
    background: transparent;
}

QCheckBox#CardCheckBox {
    color: #888888;
    font-family: "Segoe UI";
    font-size: 11px;
    background: transparent;
    border: none;
}

QCheckBox#CardCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border: 1px solid #444444;
    background-color: #2a2a2a;
}

QCheckBox#CardCheckBox::indicator:checked {
    background-color: #007ACC;
    border-color: #007ACC;
}

QPushButton#RemoveBtn {
    background: transparent;
    color: #FF5555;
    font-family: "Segoe UI";
    font-size: 12px;
    font-weight: bold;
    border-radius: 6px;
    padding: 6px 16px;
    border: none;
}

QPushButton#RemoveBtn:hover {
    background-color: #db2e2e;
    color: #FFFFFF;
}

QPushButton#DropdownTrigger {
    background-color: #2a2a2a;
    border: 1px solid #3d3d3d;
    border-radius: 6px;
    min-height: 38px;
}

QPushButton#DropdownTrigger:hover {
    border-color: #555555;
}

QPushButton#DropdownTrigger:focus {
    border: 1px solid #007ACC;
}

QLabel#DropdownTextLabel {
    color: #FFFFFF;
    font-family: "Segoe UI";
    font-size: 13px;
    background: transparent;
    border: none;
}

QLabel#DropdownArrowLabel {
    color: #888888;
    font-size: 9px;
    background: transparent;
    border: none;
}

QFrame#DropdownPopupFrame {
    background: transparent;
    border: none;
}

QListWidget#DropdownPopup {
    background-color: #1e1e1e;
    color: #FFFFFF;
    border: 1px solid #3d3d3d;
    border-radius: 8px;
    outline: 0px;
    padding: 4px;
}

QListWidget#DropdownPopup::item {
    border: 1px solid transparent;
    background-color: transparent;
    color: #FFFFFF;
    padding: 6px 10px;
    border-radius: 4px;
    min-height: 22px;
}

QListWidget#DropdownPopup::item:selected,
QListWidget#DropdownPopup::item:hover {
    background-color: #007ACC;
    color: #FFFFFF;
    border: 1px solid #121212;
}
